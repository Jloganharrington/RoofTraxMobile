modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "typecheck-mobile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mobile && npx tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && npx tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "artifacts/signing-portal: web"
author = "agent"
mode = "parallel"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/signing-portal"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/signing-portal run dev"
cwd = "./artifacts/signing-portal"
waitForPort = 24332
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "24332"
BASE_PATH = "/signing-portal/"

[[workflows.workflow]]
name = "artifacts/axiomrestore-web: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/axiomrestore-web"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/axiomrestore-web run dev"
cwd = "./artifacts/axiomrestore-web"
waitForPort = 25654
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "25654"
BASE_PATH = "/axiomrestore-web/"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "artifacts/photo-portal: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/photo-portal"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/photo-portal run dev"
cwd = "./artifacts/photo-portal"
waitForPort = 24331
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "24331"
BASE_PATH = "/photo-portal/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "artifacts/mobile: expo"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/mobile"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mobile run dev"
cwd = "./artifacts/mobile"
waitForPort = 18115
ensurePreviewReachable = "/status"
router = "expo-domain"

[workflows.workflow.tasks.env]
PORT = "18115"
BASE_PATH = "/"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
BRAIN_BASE_URL = "https://rooftrax-brain.replit.app"

[userenv.development]
TRIAL_DEV_FAKE_PAYMENTS = "1"

[objectStorage]
defaultBucketID = "replit-objstore-da678013-94d4-4901-910c-233f65607348"
